<!-- First-launch / long-task blocking overlay shown over the main shell until model checks complete. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Soul.Editor.EditorShell.UI.StartupOnboardingOverlay"
             IsVisible="False">
  <Border Background="#070F1BEF"
          BorderBrush="#4AA3FF"
          BorderThickness="1.2"
          CornerRadius="10"
          Padding="18"
          Margin="40,28">
    <StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Stretch" Margin="4,0">
      <TextBlock Text="Welcome to Soul Loom" Foreground="#E8F3FF" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="Checking local model state before the welcome step. Quick Setup and Models &amp; LLM use the same status labels (Installed / Not found) and download progress overlay."
                 Foreground="#CFE5FF"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="StartupOnboardingStatusText"
                 Text="Preparing first-launch check…"
                 Foreground="#9FCCFF"
                 FontSize="13"
                 TextWrapping="Wrap" />
      <ProgressBar x:Name="StartupOnboardingProgressBar"
                   IsIndeterminate="True"
                   Height="8"
                   Background="#0B1524"
                   Foreground="#4AA3FF" />
    </StackPanel>
  </Border>
</UserControl>
