<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Soul.Editor.EditorShell.UI.WorkflowNavigationBar">
  <Border Background="#1A2436" BorderBrush="#264566" BorderThickness="0,0,1,0" Padding="8,12">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="NavButtonPanel" Spacing="6" />
    </ScrollViewer>
  </Border>
</UserControl>
