# Soul Loom — local model management (Python orchestration)
# Legacy aliases: the same values are read from FORGEENGINE_* if SOUL_LOOM_* is unset.

SOUL_LOOM_MODELS_DIR=models/artifacts
SOUL_LOOM_ALLOW_CPU_FALLBACK=true
SOUL_LOOM_MAX_MODELS=3

# Optional: override detected VRAM (GB) for model selection heuristics
# SOUL_LOOM_GPU_VRAM_GB=8
